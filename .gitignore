# Build output
/bin/
/dist/
*.exe
*.test
*.out

# Runtime data: a local server writes its database and blobs here.
/data/
*.db
*.db-shm
*.db-wal

# Dashboard. web/out is the export; internal/server/web/dist is the copy that
# gets embedded, and is generated by `make web` rather than committed. The
# .gitkeep is tracked so //go:embed still resolves in a fresh checkout.
/web/out/
/web/.next/
/web/node_modules/
/web/next-env.d.ts
/web/.turbo/
/internal/server/web/dist/*
!/internal/server/web/dist/.gitkeep

# Editors and OS junk
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local environment
.env
.env.local
