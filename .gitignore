# Build output
/bin/
/dist/
*.exe
*.test
*.out

# Runtime data: a local server writes its database and blobs here, and a local
# agent or server run leaves its log behind.
/data/
*.db
*.db-shm
*.db-wal
*.log

# Dashboard. web/out is the export; internal/server/web/dist is the copy that
# gets embedded, and is generated by `make web` rather than committed. The
# .gitkeep is tracked so //go:embed still resolves in a fresh checkout.
/web/out/
/web/.next/
/web/node_modules/
/web/next-env.d.ts
/web/.turbo/
/internal/server/web/dist/*
!/internal/server/web/dist/.gitkeep

# Desktop app. The window's frontend is built into desktop/frontend/dist and
# embedded by Wails; the binaries and the Wails-generated bindings are build
# output. The .gitkeep is tracked so //go:embed still resolves in a fresh
# checkout, and vite.config.ts rewrites it after each build.
/desktop/frontend/node_modules/
/desktop/frontend/dist/*
!/desktop/frontend/dist/.gitkeep
/desktop/frontend/wailsjs/
# Wails hashes package.json here to decide whether to reinstall.
/desktop/frontend/package.json.md5
/desktop/build/bin/

# Editors and OS junk
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local environment
.env
.env.local
.env.production